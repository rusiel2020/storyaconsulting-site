---
import Base from '../../layouts/Base.astro';
import DataLineTemplate from '../../components/DataLineTemplate.astro';
---

<Base title="Thanks | StoryaConsulting" description="Your answers have been received." path="/start/thanks/" noindex>
<div class="pagehead">
    <p class="eyebrow">Received</p>
    <h1>Thanks, <em>we've got it.</em></h1>
    <div class="prose">
      <p>One of us will read your answers and write back within one working day. While you wait, here is something you can use on Monday without us.</p>
    </div>
  </div>

  <DataLineTemplate />

  <div class="cta-row" style="margin-top:2.4rem">
    <a class="btn btn--quiet" href="/">Back to the site</a>
    <a class="linkcap" href="/#videos">Watch the series</a>
  </div>
</Base>
